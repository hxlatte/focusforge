# Copy to .env and fill in. Never commit .env or the service-account file.
FIREBASE_PROJECT_ID=focusforge-3a4f7
# Path to a service-account JSON downloaded from Firebase console
# (Project settings -> Service accounts -> Generate new private key).
GOOGLE_APPLICATION_CREDENTIALS=./service-account.json
# Comma-separated origins allowed to call this API from the browser.
ALLOWED_ORIGINS=http://127.0.0.1:5504,http://localhost:5504,https://focusforge-3a4f7.web.app,https://focusforge-3a4f7.firebaseapp.com
